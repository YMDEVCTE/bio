<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<meta name="theme-color" content="#0a0a14">
<title>NICO_YM | YMCTE — Roblox Scripter</title>
<link rel="preconnect" href="https://images.unsplash.com" crossorigin>
<link rel="preconnect" href="https://wsrv.nl" crossorigin>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', system-ui, sans-serif; }
  html, body { overflow-x: hidden; }

  :root {
    --primary: #00ff96;
    --secondary: #00b3ff;
    --glow: rgba(0, 255, 150, 0.5);
    --glow-soft: rgba(0, 255, 150, 0.15);
    --bg-1: #0a0a14;
    --card: rgba(20, 20, 35, 0.55);
    --border: rgba(255, 255, 255, 0.08);
    --text: #ffffff;
    --text-dim: #8a8aa0;
  }

  body {
    background: var(--bg-1);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
    position: relative;
    overflow-x: hidden;
  }

  .bg-image {
    position: fixed;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1400&q=55') center/cover no-repeat;
    z-index: -4;
    opacity: 0.15;
    pointer-events: none;
  }

  .bg-glow {
    position: fixed;
    inset: 0;
    background: 
      radial-gradient(circle at 20% 20%, var(--glow-soft) 0%, transparent 40%),
      radial-gradient(circle at 80% 80%, rgba(0, 179, 255, 0.08) 0%, transparent 40%);
    z-index: -3;
    pointer-events: none;
    opacity: 0.5;
    transition: background 1.2s;
  }

  .bg-grid {
    position: fixed;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: -2;
    pointer-events: none;
  }

  .aurora {
    position: fixed;
    top: -25%; left: -25%;
    width: 150%; height: 150%;
    background: radial-gradient(ellipse at 50% 50%, var(--glow-soft) 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
    animation: auroraMove 30s ease-in-out infinite;
    opacity: 0.4;
    transition: background 1.2s;
  }
  @keyframes auroraMove {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%      { transform: translate(2%, -2%) scale(1.05); }
  }
  @media (min-width: 1024px) {
    .aurora { filter: blur(40px); }
  }

  #fxCanvas {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  #loading {
    position: fixed; inset: 0;
    background: #0a0a14;
    display: flex; justify-content: center; align-items: center;
    z-index: 99999;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }
  #loading.hide { opacity: 0; visibility: hidden; }
  .loader-wrap { position: relative; width: 70px; height: 70px; }
  .loader-ring {
    position: absolute; inset: 0;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--primary);
    border-right-color: var(--secondary);
    animation: spin 0.9s linear infinite;
  }
  .loader-ring:nth-child(2) { inset: 8px; border-top-color: var(--secondary); border-right-color: var(--primary); animation: spin 1.3s linear reverse infinite; }
  .loader-ring:nth-child(3) { inset: 16px; border-top-color: var(--primary); animation: spin 1.7s linear infinite; }
  .loader-dot {
    position: absolute; top: 50%; left: 50%;
    width: 6px; height: 6px; margin: -3px 0 0 -3px;
    background: var(--primary);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--primary);
    animation: pulseDot 1.2s ease-in-out infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.5); opacity: 0.6; }
  }

  .card-wrap {
    position: relative;
    max-width: 460px;
    width: 100%;
    z-index: 1;
    animation: cardIn 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(30px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .card-wrap::before {
    content: '';
    position: absolute;
    inset: -1.5px;
    border-radius: 26px;
    background: conic-gradient(
      from var(--angle, 0deg),
      transparent 0deg,
      var(--primary) 60deg,
      transparent 120deg,
      transparent 180deg,
      var(--secondary) 240deg,
      transparent 300deg,
      transparent 360deg
    );
    z-index: -1;
    opacity: 0.7;
    animation: rotateBorder 8s linear infinite;
  }

  @keyframes rotateBorder {
    to { --angle: 360deg; }
  }

  .card-wrap::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 30px;
    background: var(--glow-soft);
    filter: blur(24px);
    z-index: -2;
    opacity: 0.5;
    transition: background 1.2s, opacity 0.4s;
  }

  .card-wrap:hover::after { opacity: 0.8; }

  .card {
    width: 100%;
    background: var(--card);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 32px 28px;
    position: relative;
    overflow: hidden;
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset,
      0 0 60px var(--glow-soft);
  }

  @supports not (backdrop-filter: blur(14px)) {
    .card { background: rgba(20, 20, 35, 0.85); }
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 15%; right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--primary), transparent);
    opacity: 0.9;
  }

  .card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 25%; right: 25%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--secondary), transparent);
    opacity: 0.4;
  }

  .glass-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0.03) 30%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.03) 70%, transparent 100%);
    transform: skewX(-15deg);
    animation: glassShine 10s ease-in-out infinite;
    pointer-events: none;
    z-index: 5;
  }
  @keyframes glassShine {
    0%, 65% { left: -100%; }
    85%, 100% { left: 150%; }
  }

  .top-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
    opacity: 0;
    animation: fadeInUp 0.6s ease 0.15s forwards;
    gap: 10px;
    flex-wrap: wrap;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    font-weight: 700;
    color: var(--primary);
    padding: 4px 10px;
    background: var(--glow-soft);
    border: 1px solid var(--glow);
    border-radius: 20px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .status-badge .dot {
    width: 6px;
    height: 6px;
    background: var(--primary);
    border-radius: 50%;
    animation: statusPulse 2s ease-in-out infinite;
  }

  .status-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: var(--text-dim);
    font-weight: 600;
    font-family: ui-monospace, monospace;
  }

  .ping-indicator { display: inline-flex; align-items: center; gap: 4px; }

  .ping-bar {
    display: inline-block;
    width: 3px;
    height: 8px;
    background: var(--primary);
    border-radius: 1px;
    opacity: 0.4;
  }
  .ping-bar:nth-child(1) { height: 4px; opacity: 0.5; }
  .ping-bar:nth-child(2) { height: 6px; opacity: 0.7; }
  .ping-bar:nth-child(3) { height: 8px; opacity: 1; }

  .header {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeInUp 0.6s ease 0.25s forwards;
  }

  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .avatar-wrap:hover { transform: scale(1.05); }

  .avatar {
    width: 92px; height: 92px;
    border-radius: 50%;
    overflow: hidden;
    background: #1a1a2e;
    position: relative;
    z-index: 2;
    box-shadow: 
      0 0 0 2px rgba(255, 255, 255, 0.1),
      0 0 0 4px rgba(0, 0, 0, 0.4),
      0 10px 30px rgba(0, 0, 0, 0.5),
      0 0 30px var(--glow-soft);
  }

  .avatar-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--primary);
    opacity: 0;
    animation: pulseRing 2.5s ease-out infinite;
    z-index: 1;
    pointer-events: none;
  }
  .avatar-ring:nth-child(2) { animation-delay: 0.8s; }
  .avatar-ring:nth-child(3) { animation-delay: 1.6s; }
  @keyframes pulseRing {
    0% { transform: scale(0.95); opacity: 0.7; border-color: var(--primary); }
    100% { transform: scale(1.4); opacity: 0; border-color: var(--secondary); }
  }

  .avatar img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-fallback {
    width: 100%; height: 100%;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    font-weight: 800;
    color: #0a0a14;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    letter-spacing: -1px;
  }

  .status-dot {
    position: absolute;
    bottom: 2px; right: 2px;
    width: 20px; height: 20px;
    background: var(--primary);
    border: 3px solid var(--bg-1);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--primary);
    z-index: 4;
    animation: statusPulse 2s ease-in-out infinite;
  }
  @keyframes statusPulse {
    0%, 100% { box-shadow: 0 0 8px var(--primary); }
    50%      { box-shadow: 0 0 20px var(--primary), 0 0 32px var(--glow); }
  }

  .info { flex: 1; min-width: 0; }

  .name {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 5px;
    background: linear-gradient(90deg, #fff, var(--primary), #fff, var(--primary));
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 6s linear infinite;
  }
  @keyframes shine { to { background-position: 300% center; } }

  .verified {
    width: 17px; height: 17px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: #0a0a14;
    font-weight: 900;
    flex-shrink: 0;
    -webkit-text-fill-color: #0a0a14;
  }

  .handle {
    font-size: 12px;
    color: var(--text-dim);
    margin-bottom: 8px;
  }

  .role {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    font-weight: 700;
    color: var(--primary);
    padding: 4px 11px;
    background: var(--glow-soft);
    border: 1px solid var(--glow);
    border-radius: 20px;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
  }

  .role::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
    transform: translateX(-100%);
    animation: shimmer 3s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 100% { transform: translateX(-100%); }
    50%      { transform: translateX(100%); }
  }

  .achievements {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 18px;
    opacity: 0;
    animation: fadeInUp 0.6s ease 0.35s forwards;
  }

  .achievement {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .achievement:hover {
    border-color: var(--glow);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  .achievement-icon {
    font-size: 20px;
    filter: drop-shadow(0 3px 6px rgba(0,0,0,0.5));
  }

  .achievement-label {
    font-size: 9px;
    font-weight: 700;
    color: var(--text-dim);
    text-transform: uppercase;
    text-align: center;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 16px 0;
    margin-bottom: 22px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    animation: fadeInUp 0.6s ease 0.45s forwards;
  }

  .stat {
    text-align: center;
    position: relative;
    padding: 4px 0;
  }

  .stat:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -5px; top: 20%;
    height: 60%;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--border), transparent);
  }

  .stat-value {
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    display: block;
    margin-bottom: 3px;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 9.5px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-weight: 700;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
    opacity: 0;
    animation: fadeInUp 0.6s ease 0.55s forwards;
  }

  .tag {
    font-size: 10px;
    font-weight: 600;
    padding: 5px 11px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-dim);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .tag:hover {
    color: var(--primary);
    border-color: var(--glow);
    background: var(--glow-soft);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px var(--glow-soft);
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 13px;
    text-decoration: none;
    color: var(--text);
    transition: all 0.35s ease;
    position: relative;
    overflow: hidden;
    opacity: 0;
    cursor: pointer;
  }

  .link:nth-child(1) { animation: fadeInUp 0.5s ease 0.65s forwards; }
  .link:nth-child(2) { animation: fadeInUp 0.5s ease 0.75s forwards; }
  .link:nth-child(3) { animation: fadeInUp 0.5s ease 0.85s forwards; }
  .link:nth-child(4) { animation: fadeInUp 0.5s ease 0.95s forwards; }
  .link:nth-child(5) { animation: fadeInUp 0.5s ease 1.05s forwards; }

  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .link::before {
    content: '';
    position: absolute;
    left: 0; top: 0;
    width: 3px; height: 100%;
    background: var(--primary);
    transform: scaleY(0);
    transition: transform 0.35s ease;
    transform-origin: center;
  }

  .link:hover::before { transform: scaleY(1); }

  .link:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateX(4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  .link.tiktok:hover { border-color: rgba(255, 0, 80, 0.45); background: rgba(255, 0, 80, 0.08); }
  .link.tiktok::before { background: linear-gradient(180deg, #ff0050, #ff4b8c); }
  .link.github:hover { border-color: rgba(255, 255, 255, 0.4); background: rgba(255, 255, 255, 0.08); }
  .link.github::before { background: linear-gradient(180deg, #ffffff, #888888); }
  .link.discord:hover { border-color: rgba(88, 101, 242, 0.45); background: rgba(88, 101, 242, 0.08); }
  .link.discord::before { background: linear-gradient(180deg, #5865f2, #8b5cf6); }
  .link.gunlol:hover { border-color: rgba(255, 100, 50, 0.45); background: rgba(255, 100, 50, 0.08); }
  .link.gunlol::before { background: linear-gradient(180deg, #ff6432, #ff9f1c); }

  .script-btn {
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    border: 1px solid rgba(255, 200, 0, 0.25);
    background: rgba(255, 200, 0, 0.05);
    width: 100%;
    font-size: inherit;
  }

  .script-btn:hover {
    border-color: rgba(255, 200, 0, 0.6);
    background: rgba(255, 200, 0, 0.1);
    box-shadow: 0 8px 25px rgba(255, 200, 0, 0.2);
  }

  .script-btn::before { background: linear-gradient(180deg, #ffc800, #ff8c00); }
  .script-btn .link-icon { background: rgba(255, 200, 0, 0.12); border-color: rgba(255, 200, 0, 0.15); }
  .script-btn .link-icon svg { color: #ffc800; }
  .script-btn.copied { border-color: rgba(0, 255, 150, 0.5); background: rgba(0, 255, 150, 0.08); }
  .script-btn.copied::before { background: linear-gradient(180deg, #00ff96, #00b3ff); }

  .link-icon {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
    transition: transform 0.35s ease;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .link-icon svg {
    width: 20px;
    height: 20px;
    display: block;
    transition: color 0.3s ease;
  }

  .link:hover .link-icon { transform: scale(1.12) rotate(-8deg); }

  .link.tiktok .link-icon { background: rgba(255, 0, 80, 0.12); border-color: rgba(255, 0, 80, 0.15); }
  .link.github .link-icon { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.15); }
  .link.discord .link-icon { background: rgba(88, 101, 242, 0.12); border-color: rgba(88, 101, 242, 0.15); }
  .link.gunlol .link-icon { background: rgba(255, 100, 50, 0.12); border-color: rgba(255, 100, 50, 0.15); }

  .link.tiktok .link-icon svg { color: #ff0050; }
  .link.github .link-icon svg { color: #ffffff; }
  .link.discord .link-icon svg { color: #5865f2; }
  .link.gunlol .link-icon svg { color: #ff6432; }

  .link-body { flex: 1; min-width: 0; }
  .link-title { font-size: 13px; font-weight: 700; margin-bottom: 2px; }
  .link-sub {
    font-size: 10.5px;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: ui-monospace, monospace;
  }

  .link-arrow {
    font-size: 15px;
    color: var(--text-dim);
    transition: transform 0.35s, color 0.35s;
    flex-shrink: 0;
  }

  .link:hover .link-arrow {
    transform: translateX(5px);
    color: var(--primary);
  }

  .footer {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    color: var(--text-dim);
    opacity: 0;
    animation: fadeInUp 0.6s ease 1.15s forwards;
    gap: 8px;
    flex-wrap: wrap;
  }

  .footer-left { display: flex; align-items: center; gap: 6px; }

  .live-dot {
    width: 6px;
    height: 6px;
    background: var(--primary);
    border-radius: 50%;
    animation: statusPulse 2s ease-in-out infinite;
  }

  #clock {
    color: var(--primary);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .footer-right {
    font-family: ui-monospace, monospace;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .device-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 9px;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: rgba(20, 20, 35, 0.95);
    border: 1px solid var(--glow);
    color: var(--primary);
    padding: 12px 20px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    z-index: 999999;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 30px var(--glow-soft);
    opacity: 0;
    transition: all 0.4s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
    white-space: nowrap;
  }

  .toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  .toast-icon { font-size: 16px; }

  @media (max-width: 480px) {
    body { padding: 20px 14px; }
    .card { padding: 24px 20px; border-radius: 20px; }
    .card-wrap::before { border-radius: 22px; }
    .card-wrap::after { border-radius: 24px; }
    .avatar { width: 76px; height: 76px; }
    .avatar-fallback { font-size: 28px; }
    .status-dot { width: 17px; height: 17px; }
    .name { font-size: 20px; }
    .handle { font-size: 11.5px; }
    .role { font-size: 10px; padding: 3px 9px; }
    .stat-value { font-size: 19px; }
    .stat-label { font-size: 9px; }
    .tag { font-size: 10px; padding: 4px 9px; }
    .link { padding: 12px 14px; gap: 12px; }
    .link-icon { width: 34px; height: 34px; }
    .link-icon svg { width: 18px; height: 18px; }
    .link-title { font-size: 13px; }
    .link-sub { font-size: 10px; }
    .footer { font-size: 10px; }
    .achievement-icon { font-size: 18px; }
    .achievement-label { font-size: 8.5px; }
    .device-badge { display: none; }
    .card { backdrop-filter: none; -webkit-backdrop-filter: none; background: rgba(20, 20, 35, 0.88); }
    .glass-shine { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    #fxCanvas, .aurora, .bg-image { display: none; }
  }
</style>
</head>
<body>

  <div id="loading">
    <div class="loader-wrap">
      <div class="loader-ring"></div>
      <div class="loader-ring"></div>
