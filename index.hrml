<script>
'use strict';

window.addEventListener("error", () => {
  const loadingEl = document.getElementById("loading");
  if (loadingEl) loadingEl.classList.add("hide");
});

const themes = [
  { primary: "#00ff96", secondary: "#00b3ff", rgb: [0, 255, 150],    glow: "rgba(0,255,150,0.5)",  glowSoft: "rgba(0,255,150,0.15)" },
  { primary: "#b24bff", secondary: "#ff4bd8", rgb: [178, 75, 255],   glow: "rgba(178,75,255,0.5)", glowSoft: "rgba(178,75,255,0.15)" },
  { primary: "#ff3b5c", secondary: "#ff8c42", rgb: [255, 59, 92],    glow: "rgba(255,59,92,0.5)",  glowSoft: "rgba(255,59,92,0.15)" },
  { primary: "#ff9f1c", secondary: "#ff4d00", rgb: [255, 159, 28],   glow: "rgba(255,159,28,0.5)", glowSoft: "rgba(255,159,28,0.15)" },
  { primary: "#00b3ff", secondary: "#7c4dff", rgb: [0, 179, 255],    glow: "rgba(0,179,255,0.5)",  glowSoft: "rgba(0,179,255,0.15)" }
];

let themeIndex = 0;
let currentTheme = themes[0].rgb.slice();

function applyTheme(t) {
  const root = document.documentElement;
  root.style.setProperty("--primary", t.primary);
  root.style.setProperty("--secondary", t.secondary);
  root.style.setProperty("--glow", t.glow);
  root.style.setProperty("--glow-soft", t.glowSoft);
  currentTheme = t.rgb.slice();
}
applyTheme(themes[0]);

setInterval(() => {
  themeIndex = (themeIndex + 1) % themes.length;
  applyTheme(themes[themeIndex]);
}, 6000);

const isMobile = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);

const deviceBadge = document.getElementById("deviceBadge");
if (deviceBadge) deviceBadge.textContent = isMobile ? "📱 Mobile" : "🖥 PC";

const canvas = document.getElementById("fxCanvas");
const ctx = canvas.getContext("2d");
let W = 0, H = 0, DPR = 1;

function resize() {
  DPR = Math.min(window.devicePixelRatio || 1, 1);
  W = window.innerWidth;
  H = window.innerHeight;
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
}
resize();
let resizeTimer;
window.addEventListener("resize", () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(resize, 300);
});

const BASE_COUNT = isMobile ? 12 : 25;
const FIRE_COUNT = isMobile ? 2 : 5;
const STAR_COUNT = isMobile ? 10 : 20;

const particles = [];
const stars = [];
const shootingStars = [];

function initStars() {
  stars.length = 0;
  for (let i = 0; i < STAR_COUNT; i++) {
    stars.push({
      x: Math.random() * W,
      y: Math.random() * H,
      r: Math.random() * 1 + 0.4,
      phase: Math.random() * Math.PI * 2,
      speed: Math.random() * 0.014 + 0.008
    });
  }
}

function initParticles() {
  particles.length = 0;
  for (let i = 0; i < BASE_COUNT; i++) {
    particles.push({
      t: "dot",
      x: Math.random() * W, y: Math.random() * H,
      r: Math.random() * 1.4 + 0.4,
      dx: (Math.random() - 0.5) * 0.35,
      dy: (Math.random() - 0.5) * 0.35,
      a: Math.random() * 0.5 + 0.2
    });
  }
  for (let i = 0; i < FIRE_COUNT; i++) {
    particles.push({
      t: "fire",
      x: Math.random() * W,
      y: H + Math.random() * 100,
      r: Math.random() * 1.6 + 0.8,
      dx: (Math.random() - 0.5) * 0.22,
      dy: -(Math.random() * 0.85 + 0.4),
      a: Math.random() * 0.5 + 0.3,
      life: Math.random() * 180 + 100
    });
  }
}

initParticles();
initStars();

let last = performance.now();
let frameCount = 0;
let lastFpsCheck = last;
let adaptiveScale = 1;

function masterLoop(now) {
  const dt = Math.min(now - last, 50) / 16.67;
  last = now;

  frameCount++;
  if (now - lastFpsCheck >= 500) {
    const measuredFps = Math.round(frameCount * 1000 / (now - lastFpsCheck));
    frameCount = 0;
    lastFpsCheck = now;
    if (measuredFps < 50) adaptiveScale = Math.max(0.3, adaptiveScale - 0.15);
    else if (measuredFps > 90 && adaptiveScale < 1) adaptiveScale = Math.min(1, adaptiveScale + 0.05);
  }

  ctx.clearRect(0, 0, W, H);
  const [r, g, b] = currentTheme;
  const colorStr = `${r}, ${g}, ${b}`;

  for (let i = 0; i < stars.length; i++) {
    const s = stars[i];
    s.phase += s.speed * dt;
    const alpha = 0.3 + Math.sin(s.phase) * 0.35;
    ctx.fillStyle = `rgba(255,255,255,${Math.max(0.1, alpha)})`;
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.r, 0, 6.283);
    ctx.fill();
  }

  const activeCount = Math.floor(particles.length * adaptiveScale);
  for (let i = 0; i < activeCount; i++) {
    const p = particles[i];
    ctx.fillStyle = `rgba(${colorStr}, ${p.a})`;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, 6.283);
    ctx.fill();

    if (p.t === "dot") {
      p.x += p.dx * dt; p.y += p.dy * dt;
      if (p.x < 0 || p.x > W) p.dx *= -1;
      if (p.y < 0 || p.y > H) p.dy *= -1;
    } else {
      p.x += p.dx * dt; p.y += p.dy * dt;
      p.life -= dt;
      p.a = Math.max(0, p.a - 0.005 * dt);
      if (p.life <= 0 || p.y < -10) {
        p.y = H + 20;
        p.x = Math.random() * W;
        p.life = Math.random() * 180 + 100;
        p.a = Math.random() * 0.5 + 0.3;
      }
    }
  }

  for (let i = shootingStars.length - 1; i >= 0; i--) {
    const s = shootingStars[i];
    s.x += s.vx * dt; s.y += s.vy * dt;
    s.a -= 0.02 * dt;
    if (s.a <= 0) { shootingStars.splice(i, 1); continue; }
    const grad = ctx.createLinearGradient(s.x, s.y, s.x - s.vx * 6, s.y - s.vy * 6);
    grad.addColorStop(0, `rgba(255,255,255,${s.a})`);
    grad.addColorStop(0.5, `rgba(${colorStr}, ${s.a * 0.5})`);
    grad.addColorStop(1, `rgba(${colorStr}, 0)`);
    ctx.strokeStyle = grad;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(s.x, s.y);
    ctx.lineTo(s.x - s.vx * 6, s.y - s.vy * 6);
    ctx.stroke();
  }

  requestAnimationFrame(masterLoop);
}
requestAnimationFrame(masterLoop);

function spawnShootingStar() {
  if (shootingStars.length > 2) return;
  shootingStars.push({
    x: Math.random() * W * 0.5,
    y: Math.random() * H * 0.4,
    vx: 5 + Math.random() * 3,
    vy: 5 + Math.random() * 3,
    a: 1
  });
}
setInterval(() => { if (Math.random() < 0.35) spawnShootingStar(); }, 7000);

const toastEl = document.getElementById("toast");
const toastText = document.getElementById("toastText");
const toastIcon = document.getElementById("toastIcon");
let toastTimer;

function showToast(text, icon = "✓") {
  if (!toastEl) return;
  toastText.textContent = text;
  toastIcon.textContent = icon;
  toastEl.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toastEl.classList.remove("show"), 2200);
}

const SCRIPT_CODE = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/YMDEVCTE/Script_Super_FixLag_Roblox/main/lol.lua"))()';
const copyScriptBtn = document.getElementById("copyScriptBtn");
const scriptBtnIcon = document.getElementById("scriptBtnIcon");

async function copyToClipboard(text) {
  try {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return true;
    }
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.left = "-9999px";
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand("copy");
    document.body.removeChild(ta);
    return ok;
  } catch (e) {
    return false;
  }
}

if (copyScriptBtn) {
  copyScriptBtn.addEventListener("click", async (e) => {
    e.preventDefault();
    e.stopPropagation();
    const ok = await copyToClipboard(SCRIPT_CODE);
    if (ok) {
      scriptBtnIcon.textContent = "✓";
      copyScriptBtn.classList.add("copied");
      showToast("Đã copy Script FixLag!", "⚡");
      setTimeout(() => {
        scriptBtnIcon.textContent = "📋";
        copyScriptBtn.classList.remove("copied");
      }, 2500);
    } else {
      showToast("Không copy được!", "❌");
    }
  });
}

const music = document.getElementById("bgMusic");
music.volume = 0.3;
let musicStarted = false;
let userPaused = false;

function tryPlayMusic() {
  if (musicStarted && !userPaused) return;
  music.play().then(() => {
    musicStarted = true;
    userPaused = false;
  }).catch(() => {
    const handler = () => {
      if (!userPaused) {
        music.play().then(() => { musicStarted = true; }).catch(()=>{});
      }
      document.removeEventListener("click", handler);
      document.removeEventListener("touchstart", handler);
    };
    document.addEventListener("click", handler, { passive: true, once: true });
    document.addEventListener("touchstart", handler, { passive: true, once: true });
  });
}

function hideLoading() {
  const loadingEl = document.getElementById("loading");
  if (loadingEl) loadingEl.classList.add("hide");
}

setTimeout(hideLoading, 500);
setTimeout(hideLoading, 3000);

window.addEventListener("load", () => {
  tryPlayMusic();
}, { once: true });

setTimeout(tryPlayMusic, 800);

function updateClock() {
  const t = new Date().toLocaleTimeString("vi-VN", {
    timeZone: "Asia/Ho_Chi_Minh",
    hour: "2-digit", minute: "2-digit", hour12: false
  });
  const clockEl = document.getElementById("clock");
  if (clockEl) clockEl.textContent = t + " (GMT+7)";
}
updateClock();
setInterval(updateClock, 30000);

function updatePing() {
  const ping = 15 + Math.floor(Math.random() * 30);
  const pingEl = document.getElementById("ping-text");
  if (pingEl) pingEl.textContent = ping + "ms";
}
updatePing();
setInterval(updatePing, 3000);

function animateNumber(el, target, duration = 1600) {
  if (!el) return;
  const start = performance.now();
  function tick(now) {
    const p = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - p, 3);
    const val = Math.floor(eased * target).toLocaleString("vi-VN");
    el.textContent = val;
    if (p < 1) requestAnimationFrame(tick);
    else el.textContent = target.toLocaleString("vi-VN");
  }
  requestAnimationFrame(tick);
}

setTimeout(() => {
  animateNumber(document.getElementById("stat1"), 1);
  animateNumber(document.getElementById("stat2"), 1);
}, 1100);

document.addEventListener("visibilitychange", () => {
  if (document.hidden) {
    if (!music.paused) music.pause();
  } else {
    if (musicStarted && !userPaused) {
      music.play().catch(()=>{});
    }
  }
});
</script>

</body>
</html>
